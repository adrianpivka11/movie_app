{
  "name": "movie-app",
  "private": true,
  "version": "0.1.0",
  "description": "Movie recommendation app with React, Express, Supabase, and OpenAI embeddings.",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:mcp": "npm-run-all --parallel dev dev:mcp:movie-rag dev:mcp:series-search",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:mcp:movie-rag": "npm --prefix backend run dev:mcp:movie-rag",
    "dev:mcp:series-search": "npm --prefix backend run dev:mcp:series-search",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install",
    "test": "npm-run-all --parallel test:backend test:frontend",
    "test:backend": "npm --prefix backend run test:run",
    "test:frontend": "npm --prefix frontend run test:run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.15",
    "ai": "^7.0.28",
    "zod": "^4.4.3"
  }
}
